<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="270.0" spacing="10.0" style="-fx-background-color: #04EB36;" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.prg2.starvera.cat_up.controller.ActivityController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <VBox spacing="10.0" style="-fx-background-color: #9AFFB0;" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
        </padding>

        <Button alignment="CENTER" minWidth="58.0" mnemonicParsing="false" onAction="#onReturnButtonClick" prefHeight="26.0" style="-fx-background-color: #74A5FF;" text="Home" />

        <ListView fx:id="activityList" style="-fx-background-color: #9AFFB0;" VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>