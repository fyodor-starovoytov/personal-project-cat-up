    </padding>
    <Button alignment="TOP_RIGHT" onAction="#onTerminateButtonClick" prefHeight="26.0" prefWidth="22.0" style="-fx-background-color: #CC000E;" text="x" />

    <Label prefHeight="54.0" prefWidth="151.0" text="CAT-UP" textAlignment="CENTER">
      <font>
         <Font name="Helvetica Neue" size="13.0" />
      </font></Label>
   <Button fx:id="customizeButton" onAction="#onCustomizeButtonClick" alignment="CENTER" mnemonicParsing="false" prefHeight="53.0" prefWidth="258.0" style="-fx-background-color: #7A03AA;" text="Customize" />
   <Button fx:id="chooseButton" onAction="#onChooseButtonClick" mnemonicParsing="false" prefHeight="53.0" prefWidth="258.0" style="-fx-background-color: #C30495;" text="Choose" />
   <Button fx:id="activityButton" onAction="#onActivityButtonClick" mnemonicParsing="false" prefHeight="53.0" prefWidth="258.0" style="-fx-background-color: #04EB36;" text="Activity" />
