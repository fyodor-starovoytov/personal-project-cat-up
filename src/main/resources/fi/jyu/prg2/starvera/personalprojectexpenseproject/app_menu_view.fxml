<VBox alignment="TOP_RIGHT" prefHeight="452.0" prefWidth="278.0" spacing="20.0" style="-fx-background-color: #74A5FF;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="fi.jyu.prg2.starvera.personalprojectexpenseproject.controller.AppMenuController">
